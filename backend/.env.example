NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgresql://noteway_user:replace_me@localhost:5432/noteway
# Optional owner login for migrations; the app still uses DATABASE_URL.
# MIGRATION_DATABASE_URL=postgresql://adityasharma:replace_me@localhost:5432/noteway
JWT_SECRET=replace_with_at_least_32_random_characters
# Required for background book preparation and Q&A; not needed for search or --validate-only.
OPENAI_API_KEY=
FRONTEND_ORIGIN=http://localhost:5173
# Dedicated database only. Integration tests create and drop an isolated test schema.
TEST_DATABASE_URL=postgresql://noteway_user:replace_me@localhost:5432/noteway_test

# Maximum total chunk tokens per ingestion, including overlap.
MAX_EMBEDDING_TOKENS=1000000

# Password reset email delivery (Resend API key and verified sender).
RESEND_API_KEY=
PASSWORD_RESET_FROM=
